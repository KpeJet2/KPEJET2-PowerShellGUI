# .gitattributes — PwShGUI workspace line-ending and type rules
# VersionTag: 2605.B5.V51.0

# ── Auto-detect text and normalise ───────────────────────────────────────────
*                       text=auto

# ── PowerShell — CRLF (SIN-P006 / Windows target) ───────────────────────────
*.ps1                   text eol=crlf
*.psm1                  text eol=crlf
*.psd1                  text eol=crlf
*.ps1xml                text eol=crlf

# ── Batch / Windows scripts ──────────────────────────────────────────────────
*.bat                   text eol=crlf
*.cmd                   text eol=crlf

# ── Markup / data ────────────────────────────────────────────────────────────
*.json                  text eol=lf
*.jsonc                 text eol=lf
*.yaml                  text eol=lf
*.yml                   text eol=lf
*.md                    text eol=lf
*.xhtml                 text eol=lf
*.html                  text eol=lf
*.htm                   text eol=lf
*.xml                   text eol=lf
*.css                   text eol=lf

# ── Python ───────────────────────────────────────────────────────────────────
*.py                    text eol=lf

# ── Dotfile markers (treat as text, LF) ──────────────────────────────────────
.outline                text eol=lf
.problems               text eol=lf
.todo                   text eol=lf
.pipeline.entry         text eol=lf
.pipeline.stage         text eol=lf
.env.example            text eol=lf

# ── Binary — never diff / never normalise ────────────────────────────────────
*.png                   binary
*.jpg                   binary
*.jpeg                  binary
*.gif                   binary
*.ico                   binary
*.zip                   binary
*.exe                   binary
*.dll                   binary
*.pdf                   binary
*.lnk                   binary
